# CinderDay for Ghostty, part of cosmic-cinderday-theme (MIT).
# Colours follow the COSMIC Terminal scheme (cosmic-term/).
#
# Install: ./ghostty/install.sh puts this in ~/.config/ghostty/themes/, then in
# ~/.config/ghostty/config:
#   theme = CinderDay
# or, with the Cinder half installed too, following COSMIC's Dark / Light toggle:
#   theme = dark:Cinder,light:CinderDay

background = #E8E3E3
foreground = #1B1A1A

cursor-color = #A33D00
cursor-text = #E8E3E3

selection-background = #D3CBCB
selection-foreground = #1B1A1A

split-divider-color = #D3CBCB
unfocused-split-fill = #E8E3E3

# black
palette = 0=#EDEAEA
palette = 8=#AEA7A7
